program hello
	print *, "Hello World"

	print *, "Digite um numero para ver a tabuada: "
    read(*, *) numero

	print *, "=========================="
	print *, "TABUADA: "
	print *, "=========================="

	do i = 1, 10
    resultado = numero * i
    print *, numero, " x ", i, " = ", resultado
    end do

end program hello

! PARADIGMA: Imperativo = Sequência de comandos que altera o estado

